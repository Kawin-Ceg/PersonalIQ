# Copy to backend/.env and fill in. Never commit .env.

# ---- Backend ----
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/personaliq
FRONTEND_ORIGIN=http://localhost:3000

# ---- Language model (optional) ----
# Used only to read requests and to phrase short texts. Never for money math, never to approve
# or pay. With no key at all, PersonalIQ uses its built-in rules and fixed texts, and still works.
#
# Any OpenAI-compatible endpoint works. Set the three LLM_* values (LLM_PROVIDER is just a label):
#   NVIDIA (default, tested):  LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
#   Groq (untested):           LLM_BASE_URL=https://api.groq.com/openai/v1         LLM_MODEL=<a Groq model id>
#   Gemini (untested):         LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<a Gemini model id>
#   Ollama, local (untested):  LLM_BASE_URL=http://localhost:11434/v1              LLM_MODEL=<a pulled model>  LLM_API_KEY=ollama
LLM_PROVIDER=NVIDIA
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=12
# Or OpenRouter (tested; used when LLM_API_KEY is empty). Timeout accepts "90" or "90s".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90

# ---- PayPal Sandbox ----
# developer.paypal.com > Apps & Credentials > Sandbox > Create App (type: Merchant), linked to a
# US Sandbox *business* account. Pay with a US Sandbox *personal* account. India-registered
# Sandbox accounts can't complete these payments (see docs/PAYMENT_FLOW.md, "Currency").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
# Currency PayPal charges in. Orders show in the user's own currency and convert at a fixed demo rate.
PAYPAL_CURRENCY=USD
# Only for webhooks, which need a public tunnel to the backend (docs/PAYMENT_FLOW.md). Payments work without it.
PAYPAL_WEBHOOK_ID=

# ---- Frontend ----
# Put this one in frontend/.env.local (read by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
